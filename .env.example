# CAREVA Environment Variables
# Copy this file to server/.env and fill in values

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/careva?schema=public"

# Auth
JWT_SECRET="change-this-to-a-long-random-secret-in-production"
JWT_EXPIRES_IN="7d"
SESSION_SECRET="change-this-session-secret"

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL="http://localhost:5173"

# AI Provider (demo | openai | gemini)
AI_PROVIDER=demo
AI_API_KEY=

# File uploads
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=./uploads
